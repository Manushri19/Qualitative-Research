# Ollama configuration for local model inference
OLLAMA_BASE_URL=http://localhost:11434

# LlamaIndex / LlamaParse API Key (for premium PDF extraction)
# Get a free key from https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# LlamaParse parsing profiles
LLAMA_PARSE_MODE_STANDARD=accurate
LLAMA_PARSE_MODE_PREMIUM=premium
